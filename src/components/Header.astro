---
/**
 * Slim header. Full product nav stays minimal while Hyphos is in design-
 * partner stage — the deep pages still resolve by URL but aren't featured.
 * The CTA points at the pilot / contact path, not a self-serve signup.
 *
 * Mobile: hamburger reveals a full-screen panel with the nav links.
 */
import Mark from './Mark.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-slate-950/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label="Hyphos — home">
        <Mark size={28} color="#ffffff" accent="#22d3ee" />
        <span class="text-lg font-bold tracking-tight text-white">Hyphos</span>
        <span class="hidden sm:inline-block text-xs uppercase tracking-widest text-slate-500 ml-1.5 border-l border-white/10 pl-3">Design partners</span>
      </a>

      {/* Desktop nav */}
      <div class="hidden sm:flex items-center gap-5">
        <a href="/about" class="text-sm text-slate-400 hover:text-white transition-colors">About</a>
        <a href="/architecture" class="text-sm text-slate-400 hover:text-white transition-colors">Architecture</a>
        <a href="/pricing" class="text-sm text-slate-400 hover:text-white transition-colors">Pilots</a>
        <a href="https://hyphosconsulting.com" class="hidden md:inline-block text-sm text-slate-400 hover:text-white transition-colors">Hyphos Consulting →</a>
        <a href="/contact" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-600 text-white hover:bg-indigo-500 transition-colors">
          Talk about a pilot
        </a>
      </div>

      {/* Mobile: CTA + hamburger */}
      <div class="flex sm:hidden items-center gap-3">
        <a href="/contact" class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg bg-indigo-600 text-white hover:bg-indigo-500 transition-colors">
          Talk about a pilot
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-white/10 text-slate-300 hover:bg-white/5 transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="icon-close" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile panel — full-width below the header */}
  <div
    id="mobile-menu-panel"
    class="hidden sm:hidden border-t border-white/5 bg-slate-950/95 backdrop-blur-xl"
  >
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1">
      <a href="/about" class="px-3 py-3 rounded-lg text-base text-slate-200 hover:bg-white/5 transition-colors">About</a>
      <a href="/architecture" class="px-3 py-3 rounded-lg text-base text-slate-200 hover:bg-white/5 transition-colors">Architecture</a>
      <a href="/pricing" class="px-3 py-3 rounded-lg text-base text-slate-200 hover:bg-white/5 transition-colors">Pilots</a>
      <a href="/contact" class="px-3 py-3 rounded-lg text-base text-slate-200 hover:bg-white/5 transition-colors">Contact</a>
      <div class="my-2 border-t border-white/5"></div>
      <a href="https://hyphosconsulting.com" class="px-3 py-3 rounded-lg text-base text-slate-400 hover:bg-white/5 hover:text-white transition-colors">Hyphos Consulting →</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-toggle');
    const panel = document.getElementById('mobile-menu-panel');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!btn || !panel) return;

    btn.addEventListener('click', () => {
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', isOpen);
      iconOpen.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      btn.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    });
  })();
</script>
