---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
---

<BaseLayout
  title="Sign in"
  description="Sign in to your Hyphos account."
>
  <section class="min-h-screen flex items-center justify-center pt-24 pb-16 px-4">
    <div class="w-full max-w-sm">

      <!-- Logo mark -->
      <div class="flex justify-center mb-8">
        <a href="/" class="flex items-center gap-2.5">
          <Mark size={40} color="#ffffff" accent="#22d3ee" />
        </a>
      </div>

      <!-- Heading -->
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-white mb-2">Welcome back</h1>
        <p class="text-sm text-slate-400">Sign in to your Hyphos account</p>
      </div>

      <!-- Form card -->
      <div class="bg-white/[0.03] border border-white/8 rounded-2xl p-8 backdrop-blur-sm">
        <form id="login-form" class="space-y-5" novalidate>

          <div>
            <label for="email" class="block text-xs font-medium text-slate-400 mb-1.5">Email</label>
            <input
              id="email"
              type="email"
              autocomplete="email"
              required
              class="w-full px-3.5 py-2.5 bg-white/5 border border-white/10 rounded-lg text-sm text-white placeholder:text-slate-600 focus:outline-none focus:border-indigo-500/60 focus:bg-white/8 transition-colors"
              placeholder="alex@company.com"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-medium text-slate-400">Password</label>
              <button
                type="button"
                id="forgot-btn"
                class="text-xs text-indigo-400 hover:text-indigo-300 transition-colors"
              >
                Forgot password?
              </button>
            </div>
            <input
              id="password"
              type="password"
              autocomplete="current-password"
              required
              class="w-full px-3.5 py-2.5 bg-white/5 border border-white/10 rounded-lg text-sm text-white placeholder:text-slate-600 focus:outline-none focus:border-indigo-500/60 focus:bg-white/8 transition-colors"
              placeholder="Your password"
            />
          </div>

          <!-- Status messages -->
          <div id="error-msg" class="hidden rounded-lg bg-red-500/10 border border-red-500/20 px-4 py-3 text-sm text-red-400"></div>
          <div id="success-msg" class="hidden rounded-lg bg-emerald-500/10 border border-emerald-500/20 px-4 py-3 text-sm text-emerald-400"></div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 rounded-lg bg-indigo-600 text-white font-semibold text-sm hover:bg-indigo-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <span id="btn-text">Sign in</span>
            <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </button>

        </form>
      </div>

      <p class="mt-6 text-center text-sm text-slate-500">
        Don't have an account?
        <a href="/signup" class="text-indigo-400 hover:text-indigo-300 transition-colors font-medium">Start free trial</a>
      </p>

    </div>
  </section>
</BaseLayout>

<script>
  import { supabase, APP_URL } from '../lib/supabase';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg')!;
  const successMsg = document.getElementById('success-msg')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text')!;
  const btnSpinner = document.getElementById('btn-spinner')!;
  const forgotBtn = document.getElementById('forgot-btn')!;

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Signing in…' : 'Sign in';
    btnSpinner.classList.toggle('hidden', !loading);
  }

  function showError(msg: string) {
    successMsg.classList.add('hidden');
    errorMsg.textContent = msg;
    errorMsg.classList.remove('hidden');
  }

  function showSuccess(msg: string) {
    errorMsg.classList.add('hidden');
    successMsg.textContent = msg;
    successMsg.classList.remove('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    successMsg.classList.add('hidden');

    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    if (!email || !password) {
      showError('Please enter your email and password.');
      return;
    }

    setLoading(true);

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    setLoading(false);

    if (error) {
      if (error.message.includes('Invalid login')) {
        showError('Incorrect email or password.');
      } else if (error.message.includes('Email not confirmed')) {
        showError('Please verify your email before signing in. Check your inbox.');
      } else {
        showError(error.message);
      }
      return;
    }

    window.location.href = APP_URL;
  });

  // Forgot password
  forgotBtn.addEventListener('click', async () => {
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    if (!email) {
      showError('Enter your email address first, then click "Forgot password?"');
      return;
    }

    forgotBtn.textContent = 'Sending…';
    forgotBtn.setAttribute('disabled', 'true');

    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${APP_URL}/auth/reset-password`,
    });

    forgotBtn.removeAttribute('disabled');
    forgotBtn.textContent = 'Forgot password?';

    if (error) {
      showError(error.message);
    } else {
      showSuccess(`Password reset link sent to ${email}. Check your inbox.`);
    }
  });
</script>
