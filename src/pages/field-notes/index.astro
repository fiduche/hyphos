---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/field-notes.css';
const notes = [
  {number:'01',kind:'Contracts & requirements · Practical guide',title:'What Does This Work Need To Satisfy?',description:'Connect contract commitments and regulatory requirements to scope, assigned work and evidence.',href:'/field-notes/which-document-can-you-trust/'},
  {number:'02',kind:'AI & people · Practical guide',title:'What Should AI Handle, And What Should A Person Decide?',description:'A way to separate preparation, checking and judgment before automating a workflow.',href:'/field-notes/what-should-ai-handle/'},
  {number:'03',kind:'Small business · Practical guide',title:'10 Ways Small Businesses Are Actually Using AI Right Now',description:'The unglamorous things that quietly take hours out of a week, and the reason most of it disappoints the first time.',href:'/field-notes/ten-ways-small-businesses-use-ai/'},
  {number:'04',kind:'Connected systems · Client case study',title:'When Your Website Becomes Part Of Your Business',description:'See how business records, staff-reviewed publishing and marketing feedback connect in software we built.',href:'/work/cornerstone/'},
  {number:'05',kind:'Working with AI · Practical guide',title:'The Decision It Missed Was Reversed Three Weeks Ago',description:'Why asking AI what you decided returns a confident, out-of-date answer, and the change in reading order that fixes it.',href:'/field-notes/the-decision-it-missed/'},
  {number:'06',kind:'Working with AI · Practical guide',title:'It Said It Had Read Everything. It Hadn\u2019t.',description:'An agent reported twelve hours of meetings as reviewed. It had skimmed. The three questions that expose it.',href:'/field-notes/it-said-it-read-everything/'}
];
---
<BaseLayout title="Field Notes: Useful Ideas For The Work Behind Your Business" description="Practical Hyphos guides on documents, AI and connected business systems. Read the examples and sources freely, without registration.">
  <div class="fn-page"><section class="fn-shell"><p class="fn-meta">Field notes · Hyphos Inc.</p><h1>Ideas You Can<br />Put To Work</h1><p class="fn-deck fn-index-intro">Practical guides and a client case study. Open to read and share. No signup.</p>
    <div class="fn-list">{notes.map(note=><a href={note.href}><span class="fn-number">{note.number}</span><div><small>{note.kind}</small><h2>{note.title}</h2><p>{note.description}</p></div><span aria-hidden="true">↗</span></a>)}</div>
  </section></div>
</BaseLayout>
