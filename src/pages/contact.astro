---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with the Hyphos team. We're shaping a small cohort of pilot engagements with consulting firms and project teams running complex work.">

  <section class="pt-32 pb-24 sm:pt-40 sm:pb-32 relative">
    <div class="absolute inset-0 bg-grid" />
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">Get in touch</h1>
      <p class="mt-6 text-xl text-slate-400 leading-relaxed">
        Hyphos is in design partnership now — a small cohort of teams running real engagements where the cost of forgetting is high. If your organization's IP is the craft of its seniors and you're curious whether Hyphos is the right fit, write to us. We reply personally.
      </p>

      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        <!-- Email -->
        <div class="glass-card rounded-xl p-7">
          <div class="w-10 h-10 rounded-lg bg-indigo-500/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Email us</h3>
          <a href="mailto:info@hyphos.io" class="text-indigo-400 hover:text-indigo-300 transition-colors">
            info@hyphos.io
          </a>
        </div>

        <!-- Pilot -->
        <div class="glass-card rounded-xl p-7">
          <div class="w-10 h-10 rounded-lg bg-cyan-500/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Pilot a real engagement</h3>
          <p class="text-sm text-slate-400">
            We're shaping pilots with organizations where complex knowledge work compounds in value when captured. Tell us about the engagement you have in mind and we'll talk about whether it's the right shape for Hyphos.
          </p>
        </div>
      </div>

      <!-- Contact form -->
      <div class="mt-16">
        <h2 class="text-2xl font-bold text-white mb-8">Send us a message</h2>
        <form id="contact-form" class="space-y-6" action="https://formspree.io/f/placeholder" method="POST">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-300 mb-2">Name</label>
              <input type="text" id="name" name="name" required
                class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-white/10 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-colors" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-2">Email</label>
              <input type="email" id="email" name="email" required
                class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-white/10 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-colors" />
            </div>
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-slate-300 mb-2">Company</label>
            <input type="text" id="company" name="company"
              class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-white/10 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-colors" />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-slate-300 mb-2">Message</label>
            <textarea id="message" name="message" rows="4" required
              class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-white/10 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-colors resize-y"></textarea>
          </div>
          <button type="submit"
            class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-semibold rounded-lg bg-indigo-600 text-white hover:bg-indigo-500 transition-all glow-indigo">
            Send Message
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </button>
        </form>
      </div>

    </div>
  </section>

</BaseLayout>
