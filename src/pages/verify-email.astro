---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mark from '../components/Mark.astro';
---

<BaseLayout
  title="Check your email"
  description="Verify your email to activate your Hyphos account."
>
  <section class="min-h-screen flex items-center justify-center pt-24 pb-16 px-4">
    <div class="w-full max-w-sm text-center">

      <!-- Logo mark -->
      <div class="flex justify-center mb-8">
        <a href="/" class="flex items-center gap-2.5">
          <Mark size={40} color="#ffffff" accent="#22d3ee" />
        </a>
      </div>

      <!-- Email icon -->
      <div class="flex justify-center mb-6">
        <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center">
          <svg class="w-8 h-8 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
          </svg>
        </div>
      </div>

      <h1 class="text-2xl font-bold text-white mb-3">Check your inbox</h1>
      <p class="text-slate-400 text-sm leading-relaxed mb-2">
        We sent a confirmation link to
      </p>
      <p id="email-display" class="text-white font-medium mb-6 text-sm">your email address</p>
      <p class="text-slate-500 text-sm leading-relaxed mb-8">
        Click the link in the email to activate your account and start your 14-day trial. The link expires in 24 hours.
      </p>

      <div class="bg-white/[0.03] border border-white/8 rounded-xl p-5 text-left mb-6">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Didn't receive it?</p>
        <ul class="space-y-2 text-sm text-slate-500">
          <li class="flex items-start gap-2">
            <span class="text-slate-600 mt-0.5">·</span>
            Check your spam or junk folder
          </li>
          <li class="flex items-start gap-2">
            <span class="text-slate-600 mt-0.5">·</span>
            <span>Contact <a href="mailto:info@hyphos.io" class="text-indigo-400 hover:text-indigo-300 transition-colors">info@hyphos.io</a> if you need help</span>
          </li>
        </ul>
      </div>

      <a href="/login" class="text-sm text-slate-500 hover:text-white transition-colors">
        Back to sign in
      </a>

    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const email = params.get('email');
  if (email) {
    document.getElementById('email-display')!.textContent = email;
  }
</script>
